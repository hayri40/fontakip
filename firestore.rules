rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mobile app currently does not use Firebase Auth or Firestore client SDKs.
    // Deny all direct client access until owner-scoped rules are implemented.
    match /users/{userId} {
      allow read, write: if false;
    }

    match /email_preferences/{userId} {
      allow read, write: if false;
    }

    match /portfolio_snapshots/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
